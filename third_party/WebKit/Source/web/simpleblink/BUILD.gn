# HTMLViewer - Blink Web Layer Wrapper for GLAPP
# 
# This component wraps the Blink web layer to provide HTML rendering
# capabilities for the GLAPP-based HTMLViewer application.

import("//build/config/ui.gni")
import("//third_party/WebKit/Source/config.gni")
import("//third_party/WebKit/Source/core/core.gni")
import("//third_party/WebKit/Source/platform/platform.gni")


# HTMLViewer 可执行程序示例
executable("HTMLViewer") {

  output_name = "HTMLViewer"
  # 添加 Blink 配置
  configs += [
    "//third_party/WebKit/Source:config",
    "//third_party/WebKit/Source:inside_blink",
    "//v8:external_startup_data"
  ]
  # 包含目录
  include_dirs = [
    "//v8",
    "//third_party/skia/include/utils",
  ]
  # 源文件 - HTMLViewer 封装实现
  sources = [
    "blink_web_wrapper.cc",
    "blink_web_wrapper.h",
    "pak_resource.cc",
    "pak_resource.h",
    "simple_discardable_memory_allocator.cc",
    "simple_discardable_memory_allocator.h",
    "simple_web_task_runner.cc",
    "simple_web_task_runner.h",
    "web_theme_engine_impl.cc",
    "web_theme_engine_impl.h", 
  ]
  deps = [
    "//base",
    "//base:i18n",
    "//skia",
    "//third_party/WebKit/Source/core",
    "//third_party/WebKit/Source/platform",
    "//third_party/WebKit/Source/web",
    "//third_party/WebKit/Source/wtf",
    "//v8",
    "//v8:v8_libplatform",
    "//cc/blink",
    "//ui/gfx",
    "//ui/gfx/geometry",
    "//ui/native_theme",
    "//third_party/WebKit/public:image_resources",
    "//third_party/WebKit/public:resources",
  ]
  # Disable accessibility/ARIA module
  # Note: Don't define ENABLE_ACCESSIBILITY=0, the ENABLE macro expects it to be undefined
  cflags = [
    "-isystem/usr/include",
    "-isystem/usr/include/SDL2",
    "-isystem/usr/include/x86_64-linux-gnu"
  ]

  # 2. 链接：移除之前错误的 ldflags
  # 不要使用 -L/usr/lib... 这会破坏 sysroot
  # libs = [
  #   "SDL2",
  #   "dl",
  #   "rt",
  # ]

  # 3. 终极大招：通过特定的 ldflags 强制链接器定位文件
  # 我们不给路径，直接给 .so 的全路径，绕过链接器的搜索逻辑
  ldflags = [
    "/usr/lib/x86_64-linux-gnu/libSDL2.so",
  ]
  sources += [
    # "main.cc",
    "sdl2_main.cc",
  ]
}