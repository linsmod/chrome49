# HTMLViewer - Blink Web Layer Wrapper for GLAPP
# 
# This component wraps the Blink web layer to provide HTML rendering
# capabilities for the GLAPP-based HTMLViewer application.

import("//build/config/ui.gni")
import("//third_party/WebKit/Source/config.gni")
import("//third_party/WebKit/Source/core/core.gni")
import("//third_party/WebKit/Source/platform/platform.gni")

# HTMLViewer static library - provides HTML rendering capability
source_set("HTMLViewer_source_set") {

  testonly = true

  # 依赖 - 参考 web BUILD.gn 格式
  deps = [
    "//skia",
    "//testing/gmock",
    "//testing/gtest",
    "//third_party/WebKit/Source/core",
    "//third_party/WebKit/Source/modules",
    "//third_party/WebKit/Source/platform",
    "//third_party/WebKit/Source/platform:test_support",
    "//third_party/WebKit/Source/web",
    "//third_party/WebKit/Source/web:test_support",
    "//third_party/WebKit/Source/wtf",
    "//third_party/icu",
    "//third_party/angle:translator",
    "//ui/gfx/geometry",
    "//v8",
  ]

  # 添加 Blink 配置
  configs += [
    "//third_party/WebKit/Source:config",
    "//third_party/WebKit/Source:inside_blink",
  ]
  

  # 包含目录
  include_dirs = [
    "//third_party/skia/include/utils",
  ]

  # 源文件 - HTMLViewer 封装实现
  sources = [
    "blink_web_wrapper.cc",
    "blink_web_wrapper.h",
    "pak_resource.cc",
    "pak_resource.h",
  ]
}

# HTMLViewer 可执行程序示例
executable("HTMLViewer") {

  output_name = "HTMLViewer"
  testonly = true

  deps = [
    ":HTMLViewer_source_set",
    "//base",
    "//skia",
    "//testing/gmock",
    "//third_party/WebKit/Source/core",
    "//third_party/WebKit/Source/platform",
    "//third_party/WebKit/Source/wtf",
    "//v8",
    "//v8:v8_libplatform",
  ]

  configs += [
    "//third_party/WebKit/Source:config",
    "//third_party/WebKit/Source:inside_blink",
  ]

  # 添加 v8 根目录到 include_dirs，以便 libplatform.h 能找到 "include/v8-platform.h"
  include_dirs = [ "//v8" ]

  sources = [
    "main.cc",
  ]

  configs += [ "//v8:external_startup_data" ]
}
