SVGZoomEvents ImplementedAs=SVGZoomEvent, Conditional=SVG
UIEvents ImplementedAs=UIEvent
WebKitTransitionEvent ImplementedAs=TransitionEvent

core/events/TouchEvent RuntimeEnabled=touchEnabled
